# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# All three credentials are issued together when you create the app in the Ring
# Developer Portal. The Client Secret and HMAC Signature Key are shown exactly
# once and cannot be retrieved afterwards — if they are lost, the only remedy
# before certification is deleting the app and creating a new one.

# Identifies the application to Ring.
RING_CLIENT_ID=

# Authenticates the application. Server-side only, never sent to a browser.
RING_CLIENT_SECRET=

# Does double duty: verifies inbound webhook signatures (HMAC-SHA256, hex) and
# signs account-linking nonces (HMAC-SHA256, URL-safe Base64).
RING_HMAC_KEY=

# Ring REST API base.
RING_API_BASE_URL=https://api.amazonvision.com

# Ring OAuth server.
RING_OAUTH_BASE_URL=https://oauth.ring.com

# Public HTTPS endpoint Ring posts events to. Must match the Webhook URL
# registered in the portal.
RING_WEBHOOK_URL=

# 'sandbox' uses Ring's synthetic devices and events, with no rate limits.
# 'production' talks to real linked accounts.
RING_ENVIRONMENT=sandbox
